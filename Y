<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>بحث وتلخيص</title>
<style>
:root{--bg:#eef2f1;--ink:#14302c;--muted:#5d7571;--card:#fff;--line:#d3dedb;--accent:#1f7a6d}
@media (prefers-color-scheme:dark){:root{--bg:#0f1b19;--ink:#e6f0ee;--muted:#8fa8a4;--card:#182927;--line:#294240;--accent:#4cc3b3}}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic",sans-serif;background:var(--bg);color:var(--ink);padding:16px;max-width:720px;margin-inline:auto}
h1{font-size:19px;margin:4px 0 14px}
form{display:flex;gap:8px;margin-bottom:10px}
input,select,button{font:inherit;font-size:16px;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:11px 12px}
button.go{background:var(--accent);color:#fff;border:0;padding:0 18px;cursor:pointer}
input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:14px;margin-bottom:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:10px}
.card h2{font-size:17px;margin:0 0 8px}
.card ul{margin:0 0 10px;padding-inline-start:20px;line-height:1.9}
.card p.full{margin:0 0 10px;line-height:1.9;overflow-wrap:anywhere}
.acts{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.acts button{font-size:14px;padding:6px 12px;cursor:pointer}
a{color:var(--accent);font-size:14px}
.msg{color:var(--muted);text-align:center;padding:20px}
.hint{color:var(--muted);font-size:13px;margin:0 0 12px}
.card img.thumb{width:100%;max-height:220px;object-fit:cover;border-radius:10px;margin-bottom:10px;display:block;background:var(--line)}
.search-wrap{position:relative;flex:1;min-width:0;display:flex}
.search-wrap input{flex:1;min-width:0;width:100%}
.suggest{position:absolute;top:calc(100% + 4px);right:0;left:0;background:var(--card);border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:20;max-height:280px;overflow-y:auto;padding:4px;display:none}
.suggest.open{display:block}
.suggest-item{padding:10px 12px;border-radius:8px;cursor:pointer;font-size:15px;line-height:1.4;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.suggest-item:hover,.suggest-item.active{background:var(--accent);color:#fff}
.history{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.history:empty{display:none}
.chip{display:inline-flex;align-items:center;gap:6px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:5px 10px 5px 6px;font-size:13px;cursor:pointer;color:var(--ink);max-width:220px;transition:border-color .15s}
.chip:hover{border-color:var(--accent)}
.chip .label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip .x{border:0;background:transparent;color:var(--muted);font-size:15px;line-height:1;padding:0 2px;cursor:pointer;border-radius:50%}
.chip .x:hover{color:#c0392b}
.acts button.speaking{background:var(--accent);color:#fff;border-color:var(--accent)}
.more-wrap{display:flex;justify-content:center;margin:8px 0 20px}
.more-btn{font:inherit;font-size:15px;cursor:pointer;background:var(--card);color:var(--accent);border:1px solid var(--accent);border-radius:999px;padding:10px 22px;transition:background .15s,color .15s}
.more-btn:hover{background:var(--accent);color:#fff}
.more-end{color:var(--muted);font-size:14px;text-align:center}
</style>
</head>
<body>
<h1>ابحث ولخّص</h1>
<form id="f">
  <div class="search-wrap">
    <input id="q" placeholder="اكتب اللي عايز تعرفه..." autocomplete="off" required aria-autocomplete="list" aria-controls="suggest" aria-expanded="false">
    <div class="suggest" id="suggest" role="listbox"></div>
  </div>
  <button class="go">بحث</button>
</form>
<div class="row">
  <label>اللغة: <select id="lang"><option value="ar">العربية</option><option value="en">English</option></select></label>
  <label>طول الملخص: <select id="len"><option value="2">قصير</option><option value="3" selected>متوسط</option><option value="5">طويل</option></select></label>
</div>
<div id="history" class="history"></div>
<p class="hint">التلخيص بيختار أهم الجمل من النص ويرتبها في نقاط. مش بيعيد الصياغة بكلمات جديدة.</p>
<div id="out"></div>
<script>
const out = document.getElementById("out");
const qInput = document.getElementById("q");
const langSel = document.getElementById("lang");
const suggestBox = document.getElementById("suggest");

let currentSearch = { term: "", lang: "", n: 3, offset: 0, total: 0 };

const STOP = new Set("في من على إلى الى عن مع هو هي هذا هذه ذلك التي الذي التى كان كانت أن إن ان قد لم لا ما و أو او ثم كما بين عند حتى بعد قبل هو ها the a an of and in to is was were are for on as by with at from that this it its be or which has had have".split(" "));
function clean(t){ return t.replace(/\([^)]*\)|\[[^\]]*\]|（[^）]*）/g," ").replace(/\s+/g," ").replace(/\s+([،,.؛])/g,"$1").trim(); }
function words(s){ return (s.toLowerCase().match(/[\p{L}\p{N}]+/gu)||[]).filter(w=>w.length>2&&!STOP.has(w)); }
function summarize(text, n){
  const sents = clean(text).split(/(?<=[.!؟?])\s+/).filter(s=>s.length>25);
  if (sents.length<=n) return sents;
  const freq = {};
  sents.forEach(s=>words(s).forEach(w=>freq[w]=(freq[w]||0)+1));
  const scored = sents.map((s,i)=>{
    const w = words(s);
    const sc = w.reduce((a,x)=>a+freq[x],0)/Math.sqrt(w.length||1);
    return {s,i,sc:i===0?Infinity:sc};
  });
  return scored.sort((a,b)=>b.sc-a.sc).slice(0,n).sort((a,b)=>a.i-b.i).map(x=>x.s);
}

/* Text-to-Speech */
let currentUtterance = null;
let currentSpeakBtn = null;
function stopSpeaking(){
  if (window.speechSynthesis) window.speechSynthesis.cancel();
  if (currentSpeakBtn){ currentSpeakBtn.textContent = "🔊 اسمع"; currentSpeakBtn.classList.remove("speaking"); currentSpeakBtn = null; }
  currentUtterance = null;
}
function speakText(text, lang, btn){
  if (!window.speechSynthesis){ alert("متصفحك مش بيدعم القراءة الصوتية."); return; }
  if (currentSpeakBtn === btn && window.speechSynthesis.speaking){ stopSpeaking(); return; }
  stopSpeaking();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = lang === "ar" ? "ar-EG" : "en-US";
  utter.rate = 1; utter.pitch = 1;
  const voices = window.speechSynthesis.getVoices();
  const match = voices.find(v => v.lang === utter.lang) || voices.find(v => v.lang.startsWith(lang));
  if (match) utter.voice = match;
  utter.onend = () => { if (currentUtterance === utter) stopSpeaking(); };
  utter.onerror = () => { if (currentUtterance === utter) stopSpeaking(); };
  currentUtterance = utter; currentSpeakBtn = btn;
  btn.textContent = "⏹ وقف"; btn.classList.add("speaking");
  window.speechSynthesis.speak(utter);
}
if (window.speechSynthesis){ window.speechSynthesis.getVoices(); window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices(); }

/* URL + History */
const HISTORY_KEY = "wiki_search_history_v1";
const HISTORY_MAX = 10;
function readHistory(){ try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]"); } catch { return []; } }
function writeHistory(list){ localStorage.setItem(HISTORY_KEY, JSON.stringify(list.slice(0, HISTORY_MAX))); }
function addToHistory(term, lang){
  if (!term) return;
  let list = readHistory();
  list = list.filter(x => !(x.term === term && x.lang === lang));
  list.unshift({ term, lang, time: Date.now() });
  writeHistory(list); renderHistory();
}
function removeFromHistory(term, lang){
  writeHistory(readHistory().filter(x => !(x.term === term && x.lang === lang)));
  renderHistory();
}
function renderHistory(){
  const box = document.getElementById("history");
  box.innerHTML = "";
  for (const item of readHistory()){
    const chip = document.createElement("div"); chip.className = "chip"; chip.title = item.term;
    const label = document.createElement("span"); label.className = "label"; label.textContent = item.term;
    label.onclick = ()=>{ qInput.value = item.term; langSel.value = item.lang; document.getElementById("f").requestSubmit(); };
    const x = document.createElement("button"); x.type = "button"; x.className = "x"; x.textContent = "×";
    x.onclick = (e)=>{ e.stopPropagation(); removeFromHistory(item.term, item.lang); };
    chip.append(label, x); box.append(chip);
  }
}
function syncURL(term, lang, n){
  const params = new URLSearchParams(); params.set("q", term); params.set("lang", lang); params.set("len", String(n));
  history.replaceState(null, "", `?${params.toString()}`);
}

/* Pagination */
function renderMoreButton(){
  document.querySelectorAll(".more-wrap").forEach(el => el.remove());
  if (!currentSearch.term) return;
  const wrap = document.createElement("div"); wrap.className = "more-wrap";
  if (currentSearch.offset >= currentSearch.total){
    const span = document.createElement("div"); span.className = "more-end";
    span.textContent = `خلصنا — ${currentSearch.total} نتيجة في المجمل.`; wrap.append(span);
  } else {
    const btn = document.createElement("button"); btn.type = "button"; btn.className = "more-btn"; btn.textContent = "شوف 4 كمان ↓";
    btn.onclick = () => loadResults(true); wrap.append(btn);
  }
  out.append(wrap);
}

/* Autocomplete */
let suggestItems = [], activeIndex = -1, suggestTimer = null, suggestController = null;
function closeSuggest(){ suggestBox.classList.remove("open"); suggestBox.innerHTML = ""; suggestItems = []; activeIndex = -1; qInput.setAttribute("aria-expanded","false"); }
function highlightActive(){ const nodes = suggestBox.querySelectorAll(".suggest-item"); nodes.forEach((el,i)=>el.classList.toggle("active", i===activeIndex)); const active = nodes[activeIndex]; if (active) active.scrollIntoView({block:"nearest"}); }
function chooseSuggest(text){ qInput.value = text; closeSuggest(); document.getElementById("f").requestSubmit(); }
function renderSuggest(titles){
  suggestItems = titles; activeIndex = -1; suggestBox.innerHTML = "";
  if (!titles.length){ closeSuggest(); return; }
  titles.forEach((t, i)=>{
    const d = document.createElement("div"); d.className = "suggest-item"; d.textContent = t; d.setAttribute("role","option");
    d.onmousedown = (e)=>{ e.preventDefault(); chooseSuggest(t); };
    d.onmouseenter = ()=>{ activeIndex = i; highlightActive(); };
    suggestBox.append(d);
  });
  suggestBox.classList.add("open"); qInput.setAttribute("aria-expanded","true");
}
async function fetchSuggest(term){
  if (term.length < 2){ closeSuggest(); return; }
  suggestController?.abort(); suggestController = new AbortController();
  const lang = langSel.value;
  const url = `https://${lang}.wikipedia.org/w/api.php?action=opensearch&search=${encodeURIComponent(term)}&limit=6&namespace=0&format=json&origin=*`;
  try{
    const r = await fetch(url, { signal: suggestController.signal });
    if (!r.ok) throw new Error();
    const data = await r.json();
    if (qInput.value.trim() !== term) return;
    renderSuggest(data[1] || []);
  } catch(err){ if (err.name !== "AbortError") closeSuggest(); }
}
qInput.addEventListener("input", ()=>{ const term = qInput.value.trim(); clearTimeout(suggestTimer); if (!term){ closeSuggest(); return; } suggestTimer = setTimeout(()=>fetchSuggest(term), 200); });
qInput.addEventListener("keydown", (e)=>{
  const open = suggestBox.classList.contains("open"); if (!open) return;
  if (e.key === "ArrowDown"){ e.preventDefault(); activeIndex = (activeIndex + 1) % suggestItems.length; highlightActive(); }
  else if (e.key === "ArrowUp"){ e.preventDefault(); activeIndex = (activeIndex - 1 + suggestItems.length) % suggestItems.length; highlightActive(); }
  else if (e.key === "Enter"){ if (activeIndex >= 0){ e.preventDefault(); chooseSuggest(suggestItems[activeIndex]); } }
  else if (e.key === "Escape"){ closeSuggest(); }
});
document.addEventListener("click", (e)=>{ if (!e.target.closest(".search-wrap")) closeSuggest(); });

/* البحث الرئيسي */
async function loadResults(append = false){
  const { term, lang, n } = currentSearch;
  const offset = append ? currentSearch.offset : 0;
  if (!append){
    currentSearch.offset = 0; currentSearch.total = 0; stopSpeaking();
    out.innerHTML = '<div class="msg">بدوّر...</div>';
  } else {
    const existing = out.querySelector(".more-wrap"); if (existing) existing.remove();
    const loadingMsg = document.createElement("div"); loadingMsg.className = "msg"; loadingMsg.textContent = "بجيب المزيد..."; out.append(loadingMsg);
  }
  const url = `https://${lang}.wikipedia.org/w/api.php?action=query&generator=search&gsrsearch=${encodeURIComponent(term)}&gsrlimit=4&gsroffset=${offset}&prop=extracts|info|pageimages&exintro=1&explaintext=1&exchars=2500&exlimit=max&inprop=url&piprop=thumbnail&pithumbsize=400&format=json&origin=*`;
  try {
    const r = await fetch(url); if (!r.ok) throw new Error();
    const data = await r.json();
    const pages = Object.values(data.query?.pages || {}).sort((a,b)=>a.index-b.index);
    if (append){ const loadingMsg = out.querySelector(".msg"); if (loadingMsg && loadingMsg.textContent === "بجيب المزيد...") loadingMsg.remove(); }
    else { out.textContent = ""; }
    if (data.query?.searchinfo?.totalhits !== undefined) currentSearch.total = Math.min(data.query.searchinfo.totalhits, 100);
    if (!pages.length){ if (!append){ out.innerHTML = '<div class="msg">مفيش نتايج. جرّب كلمات تانية.</div>'; } else { renderMoreButton(); } return; }
    for (const p of pages){
      const c = document.createElement("div"); c.className = "card";
      if (p.thumbnail && p.thumbnail.source) { const img = document.createElement("img"); img.src = p.thumbnail.source; img.alt = p.title; img.loading = "lazy"; img.referrerPolicy = "no-referrer"; img.className = "thumb"; img.onerror = () => img.remove(); c.append(img); }
      const h = document.createElement("h2"); h.textContent = p.title;
      const pts = summarize(p.extract || "", n);
      const ul = document.createElement("ul"); (pts.length ? pts : ["مفيش ملخص متاح."]).forEach(s=>{ const li=document.createElement("li"); li.textContent=s; ul.append(li); });
      const full = document.createElement("p"); full.className="full"; full.hidden=true; full.textContent = clean(p.extract||"");
      const acts = document.createElement("div"); acts.className="acts";
      const b1 = document.createElement("button"); b1.type="button"; b1.textContent="النص الكامل"; b1.onclick = () => { full.hidden=!full.hidden; ul.hidden=!full.hidden; b1.textContent = full.hidden ? "النص الكامل" : "الملخص"; };
      const b2 = document.createElement("button"); b2.type="button"; b2.textContent="نسخ الملخص"; b2.onclick = async () => { try { await navigator.clipboard.writeText(p.title+"\n"+pts.map(s=>"• "+s).join("\n")); b2.textContent="اتنسخ"; setTimeout(()=>b2.textContent="نسخ الملخص",1500); } catch(_){ b2.textContent="النسخ مش متاح"; } };
      const b3 = document.createElement("button"); b3.type = "button"; b3.textContent = "🔊 اسمع"; b3.onclick = () => { const txt = p.title + ". " + (pts.length ? pts.join(". ") : ""); speakText(txt, lang, b3); };
      const a = document.createElement("a"); a.href=p.fullurl; a.target="_blank"; a.rel="noopener"; a.textContent="افتح المقال";
      acts.append(b1,b2,b3,a); c.append(h,ul,full,acts); out.append(c);
    }
    currentSearch.offset = offset + pages.length; renderMoreButton();
  } catch(err){
    if (append){ const loadingMsg = out.querySelector(".msg"); if (loadingMsg && loadingMsg.textContent === "بجيب المزيد...") loadingMsg.remove(); const errDiv = document.createElement("div"); errDiv.className = "msg"; errDiv.textContent = "معرفتش أجيب المزيد. جرّب تاني."; out.append(errDiv); }
    else { out.innerHTML = '<div class="msg">معرفتش أوصل لويكيبيديا. اتأكد من الإنترنت وجرّب تاني.</div>'; }
  }
}

document.getElementById("f").onsubmit = async (e) => {
  e.preventDefault(); closeSuggest();
  const term = qInput.value.trim(); const lang = langSel.value; const n = +document.getElementById("len").value;
  if (!term) return;
  syncURL(term, lang, n); addToHistory(term, lang);
  currentSearch = { term, lang, n, offset: 0, total: 0 };
  await loadResults(false);
};

(function initFromURL(){
  renderHistory();
  const params = new URLSearchParams(location.search); const q = params.get("q"); if (!q) return;
  qInput.value = q;
  const lang = params.get("lang"); if (lang === "ar" || lang === "en") langSel.value = lang;
  const len = params.get("len"); if (len && ["2","3","5"].includes(len)) document.getElementById("len").value = len;
  document.getElementById("f").requestSubmit();
})();
</script>
</body>
</html>
